# F7 (T7.3): env de PRODUÇÃO para `docker compose -f docker-compose.prod.yml`.
# Copie para `.env.prod` (`cp .env.prod.example .env.prod`) e AJUSTE os
# valores — os abaixo são placeholders SINTÉTICOS, nunca use em produção real.
# Nunca commite `.env.prod` (coberto pelo `.gitignore`, mesma regra do `.env`
# de dev). Rode com: `docker compose -f docker-compose.prod.yml --env-file .env.prod up -d`.

# ---- Postgres (db) ----
POSTGRES_USER=estacao
# TROQUE por um segredo real e forte antes de subir em produção.
POSTGRES_PASSWORD=troque_esta_senha_por_um_segredo_forte
POSTGRES_DB=estacao_meteorologica
# POSTGRES_PORT não é usado pelo docker-compose.prod.yml: em produção o
# serviço `db` não publica porta nenhuma no host (F7 T7.2, hardening) — `api`
# e `web` alcançam `db` pela rede interna do compose (hostname `db`). Mantida
# aqui só por compatibilidade de formato com o `.env.example` de dev, que
# ainda publica a porta via `docker-compose.yml`.
POSTGRES_PORT=5432

# ---- API (Fastify) ----
# Porta do HOST mapeada para a porta 3000 do Fastify dentro do container.
# A porta INTERNA (dentro do container) é sempre 3000, fixa no
# docker-compose.prod.yml, não configurável por esta env var — `web/nginx.conf`
# depende disso (`proxy_pass http://api:3000;`, decisão D22). Ajuste
# API_PORT apenas se a porta 3000 já estiver ocupada no host.
API_PORT=3000
# NODE_ENV não é configurável aqui: o docker-compose.prod.yml fixa
# `NODE_ENV=production` para os serviços api/web (não depende desta env var).
# Segredo da estação para o header `X-API-Key` do contrato de ingestão
# (POST /api/v1/ingest). TROQUE por um segredo real e forte — ver
# docs/ingest-api.md para o formato esperado e como gerar/rotacionar.
INGEST_API_KEY=troque_por_um_segredo_real_whs_prod
# F3: teto de leituras por lote em POST /api/v1/ingest (acima disso -> 413).
MAX_BATCH=5000
# F7 (QA-07): rate limit de POST /api/v1/ingest.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
# F7 (achado de revisão): nível do logger estruturado (pino). Opcional —
# default "info". Valores válidos: trace | debug | info | warn | error |
# fatal | silent (validado por `parseLoggerEnv()` em `api/src/config/env.ts`).
LOG_LEVEL=info
# Nota: API_TARGET/WEB_TARGET (do .env.example de dev) não existem aqui —
# em produção o stage de build é sempre `runtime`, fixo no
# docker-compose.prod.yml, não configurável por env.

# ---- Web (Nginx servindo o build de produção) ----
# Porta do HOST mapeada para a porta 80 do Nginx dentro do container.
# Default sugerido 8080 (porta 80 costuma exigir privilégios/estar ocupada
# por outro serviço no host) — troque para 80 se este host for dedicado ao
# IFSClima e você tiver um reverse proxy/TLS na frente, ou ajuste conforme
# sua infraestrutura.
WEB_PORT=8080
