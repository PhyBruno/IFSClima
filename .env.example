# Copie este arquivo para `.env` e ajuste os valores (nunca commite `.env`).

# ---- Postgres (db) ----
POSTGRES_USER=estacao
POSTGRES_PASSWORD=troque_esta_senha_local
POSTGRES_DB=estacao_meteorologica
POSTGRES_PORT=5432

# ---- API (Fastify) ----
API_PORT=3000
NODE_ENV=development
# Segredo da estação para o header `X-API-Key` do contrato de ingestão (POST /api/v1/ingest).
# Ver docs/ingest-api.md.
INGEST_API_KEY=whs_test_ABC123
# F3: teto de leituras por lote em POST /api/v1/ingest (acima disso -> 413).
MAX_BATCH=5000
# Estágio de build usado pelo docker-compose (dev | build | runtime).
API_TARGET=dev

# ---- Web (Vite/React) ----
WEB_PORT=5173
# Estágio de build usado pelo docker-compose (dev | build | runtime).
WEB_TARGET=dev
