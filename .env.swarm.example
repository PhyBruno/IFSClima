# Env de PRODUÇÃO para `docker stack deploy -c docker-compose.swarm.yml` (Swarm).
# Copie para `.env.swarm` (`cp .env.swarm.example .env.swarm`) e AJUSTE os
# valores — os abaixo são placeholders SINTÉTICOS, nunca use em produção real.
# Nunca commite `.env.swarm` (mesma regra do `.env`/`.env.prod`, cobertos pelo
# `.gitignore`).
#
# `docker stack deploy` nem sempre lê `--env-file` (depende da versão do
# Docker CLI) — antes do deploy, exporte estas variáveis no shell do manager,
# por exemplo: `set -a; source .env.swarm; set +a`.

# ---- Postgres (db) ----
POSTGRES_USER=estacao
POSTGRES_PASSWORD=troque_esta_senha_por_um_segredo_forte
POSTGRES_DB=estacao_meteorologica

# ---- API (Fastify) ----
# Segredo da estação para o header `X-API-Key` do contrato de ingestão
# (POST /api/v1/ingest). TROQUE por um segredo real e forte.
INGEST_API_KEY=troque_por_um_segredo_real_swarm_prod
MAX_BATCH=5000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
LOG_LEVEL=info
